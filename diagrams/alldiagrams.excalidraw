      "fontSize": 16.193312920648324,
      "fontFamily": 5,
      "text": "#include <stdio.h>\n\ntypedef struct {\n  const char* firstname;\n  short legs_number;\n} Dog;\n\nint main(int argc, const char *argv) {\n\n  if (strcmp(argv[1], \"-n\") == 0) {\n    printf(\"New dog\\nName: \");\n    printf(\"\\nNumber of legs: \");\n  } else if (strcmp(argv[1], \"-s\") == 0) {\n    printf(\"sizeof(Dog): %d\\n\", sizeof(Dog));\n  } else {\n    Dog dog = {.firstname = argv[1], .legs_number = argv[2]};\n    printf(\"The dog is %s and has %d legs\\n\", dog.firstname, dog.legs_number);\n\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <stdio.h>\n\ntypedef struct {\n  const char* firstname;\n  short legs_number;\n} Dog;\n\nint main(int argc, const char *argv) {\n\n  if (strcmp(argv[1], \"-n\") == 0) {\n    printf(\"New dog\\nName: \");\n    printf(\"\\nNumber of legs: \");\n  } else if (strcmp(argv[1], \"-s\") == 0) {\n    printf(\"sizeof(Dog): %d\\n\", sizeof(Dog));\n  } else {\n    Dog dog = {.firstname = argv[1], .legs_number = argv[2]};\n    printf(\"The dog is %s and has %d legs\\n\", dog.firstname, dog.legs_number);\n\n",
      "autoResize": true,
      "lineHeight": 1.25
